{
    "engines": {
        "node": ">=24.0.0"
    },
    "name": "evolution-common",
    "version": "0.6.7",
    "description": "Common type library for evolution",
    "repository": "github.com/chairemobilite/evolution",
    "license": "MIT",
    "scripts": {
        "clean": "rimraf lib/",
        "cleanModules": "rimraf node_modules/",
        "compile": "tsc",
        "compile:dev": "tsc -w",
        "test": "cross-env NODE_ENV=test jest --config=jest.config.js",
        "test:unit": "cross-env NODE_ENV=test jest --config=jest.config.js",
        "test:sequential": "echo 'no tests to run for this workspace'",
        "test:ui": "echo 'no tests to run for this workspace'",
        "lint": "eslint .",
        "format": "prettier --write --log-level warn \"./src/**/*.{ts,tsx}\" && eslint --fix --quiet \"./src/**/*.{ts,tsx}\"",
        "format:all": "yarn format",
        "docs:api": "typedoc --options typedoc.json"
    },
    "dependencies": {
        "@fortawesome/fontawesome-svg-core": "^7.1.0",
        "@turf/turf": "^7.3.5",
        "chaire-lib-common": "workspace:^",
        "geojson-validation": "^1.0.2",
        "i18next": "^26.0.6",
        "lodash": "^4.18.1",
        "moment": "^2.31.0",
        "uuid": "^14.0.3"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/geojson": "^7946.0.16",
        "@types/lodash": "^4.17.23",
        "@types/node": "^24.10.4",
        "cross-env": "^10.1.0",
        "eslint": "^10.13.0",
        "eslint-plugin-n": "^18.5.0",
        "jest": "^30.5.2",
        "jest-each": "^30.5.2",
        "prettier": "^3.9.10",
        "rimraf": "^6.1.4",
        "typedoc": "^0.28.19",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.72.0"
    }
}
